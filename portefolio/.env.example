# Copier ce fichier en `.env` et renseigner les valeurs du tableau de bord EmailJS.
# Ces clés sont publiques par conception : elles sont intégrées au bundle client.
# La protection repose sur la restriction de domaine configurée côté EmailJS.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
